{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subdrop.repruv.com/v1/schema.json",
  "title": "Subdrop published catalog",
  "description": "JSON Schema for GET https://subdrop.repruv.com/v1/catalog.json (wrapper + service objects). Source YAML uses schema/service.schema.json and keeps a relative logo path; the published dump emits absolute logoUrl instead.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "description",
    "region",
    "currency",
    "license",
    "licenseNote",
    "generatedAt",
    "count",
    "categories",
    "services"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "const": "US"
    },
    "currency": {
      "type": "string",
      "const": "USD"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "licenseNote": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "description": "UTC timestamp when this dump was built (YYYY-MM-DDTHH:MM:SSZ)."
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "plan",
        "priceUsd",
        "billing",
        "monthlyUsd",
        "url",
        "sourceUrl",
        "priceCheckedAt",
        "domain",
        "aliases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "plan": {
          "type": "string",
          "minLength": 1,
          "description": "Single advertised plan label. There is no plans array."
        },
        "priceUsd": {
          "type": "number",
          "minimum": 0,
          "description": "Advertised USD price for the billing period. Always a JSON number (e.g. 17.99, 69.0), never a string."
        },
        "billing": {
          "type": "string",
          "enum": ["month", "year", "week"]
        },
        "billingMonth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "monthlyUsd": {
          "type": "number",
          "minimum": 0,
          "description": "Normalized monthly equivalent. Always a JSON number (e.g. 17.99, 69.0)."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Official service homepage. Often differs from sourceUrl."
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "description": "Page used to verify the listed price (canonical provenance URL)."
        },
        "priceCheckedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "blurb": {
          "type": "string"
        },
        "rank": {
          "type": "integer"
        },
        "color": {
          "type": "string"
        },
        "simpleIconsSlug": {
          "type": "string"
        },
        "logoUrl": {
          "type": "string",
          "format": "uri",
          "description": "Absolute CDN URL for the brand mark. Relative logo is source-only and omitted here."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "meta": {
      "title": "Subdrop catalog freshness (GET /v1/meta.json)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "generatedAt",
        "count",
        "catalogUrl",
        "schemaUrl",
        "note"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "generatedAt": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "commit": {
          "type": "string",
          "description": "Git SHA of the catalog revision that produced this publish."
        },
        "catalogUrl": {
          "type": "string",
          "format": "uri"
        },
        "schemaUrl": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
